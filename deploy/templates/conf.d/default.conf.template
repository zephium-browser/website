# zephium.app: the static export in /usr/share/nginx/html, behind Coolify's
# proxy and Cloudflare. TLS ends before this server, so it listens on 80.
server {
  listen 80;
  server_name _;
  root /usr/share/nginx/html;

  server_tokens off;
  absolute_redirect off;
  charset utf-8;

  gzip on;
  gzip_vary on;
  gzip_min_length 1024;
  gzip_types text/plain text/css application/javascript application/json application/manifest+json image/svg+xml application/xml text/xml;

  include /etc/nginx/snippets/headers.conf;

  # Pages are short-lived in caches, so a deploy shows at once.
  location / {
    include /etc/nginx/snippets/headers.conf;
    add_header Cache-Control "public, max-age=0, must-revalidate" always;
    try_files $uri $uri.html $uri/index.html =404;
  }

  # The security contact file (RFC 9116) is plain text and short-lived in caches.
  location = /.well-known/security.txt {
    include /etc/nginx/snippets/headers.conf;
    add_header Cache-Control "public, max-age=3600" always;
    default_type text/plain;
    try_files $uri =404;
  }

  # Where checkout and the billing portal send people back to. It loads no
  # analytics, so it gets its own headers instead of headers.conf: the same CSP
  # without the Umami origin, no referrer, no indexing and no caching. A
  # trailing slash is redirected once, keeping the query as it came.
  location = /billing/return {
    include /etc/nginx/snippets/headers-base.conf;
    add_header Referrer-Policy "no-referrer" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; connect-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" always;
    add_header X-Robots-Tag "noindex, nofollow" always;
    add_header Cache-Control "no-store" always;
    try_files /billing/return.html =404;
  }

  location = /billing/return/ {
    return 301 /billing/return$is_args$args;
  }

  # Hashed build files never change under the same name.
  location /_next/static/ {
    include /etc/nginx/snippets/headers.conf;
    add_header Cache-Control "public, max-age=31536000, immutable" always;
    try_files $uri =404;
  }

  # Images and marks keep their names across deploys; a day, then revalidate.
  location ~* ^/(shots|demo|marks|brand|extensions|sky|film)/ {
    include /etc/nginx/snippets/headers.conf;
    add_header Cache-Control "public, max-age=86400, stale-while-revalidate=604800" always;
    try_files $uri =404;
  }

  # The cards links share: a day, then revalidate.
  location ~ ^/(opengraph|twitter)-image\.jpg$ {
    include /etc/nginx/snippets/headers.conf;
    add_header Cache-Control "public, max-age=86400" always;
    try_files $uri =404;
  }

  # The star count, refreshed by the container (deploy/stars.sh) every
  # hour; browsers may keep it for ten minutes.
  location = /stars.json {
    include /etc/nginx/snippets/headers.conf;
    add_header Cache-Control "public, max-age=600" always;
    default_type application/json;
    try_files $uri =404;
  }

  # A plain check for Coolify.
  location = /healthz {
    access_log off;
    default_type text/plain;
    return 200 "ok\n";
  }

  error_page 404 /404.html;
}
