# zephium.app: the static export in /usr/share/nginx/html, behind Coolify's
# proxy and Cloudflare. TLS ends before this server, so it listens on 80.
server {
  listen 80;
  server_name _;
  root /usr/share/nginx/html;

  server_tokens off;
  absolute_redirect off;
  charset utf-8;

  gzip on;
  gzip_vary on;
  gzip_min_length 1024;
  gzip_types text/plain text/css application/javascript application/json application/manifest+json image/svg+xml application/xml text/xml;

  include /etc/nginx/snippets/headers.conf;

  # Pages are short-lived in caches, so a deploy shows at once.
  location / {
    include /etc/nginx/snippets/headers.conf;
    add_header Cache-Control "public, max-age=0, must-revalidate" always;
    try_files $uri $uri.html $uri/index.html =404;
  }

  # Hashed build files never change under the same name.
  location /_next/static/ {
    include /etc/nginx/snippets/headers.conf;
    add_header Cache-Control "public, max-age=31536000, immutable" always;
    try_files $uri =404;
  }

  # Images and marks keep their names across deploys; a day, then revalidate.
  location ~* ^/(shots|demo|marks|brand|extensions)/ {
    include /etc/nginx/snippets/headers.conf;
    add_header Cache-Control "public, max-age=86400, stale-while-revalidate=604800" always;
    try_files $uri =404;
  }

  # The social card is a PNG written without an extension.
  location = /opengraph-image {
    include /etc/nginx/snippets/headers.conf;
    add_header Cache-Control "public, max-age=86400" always;
    default_type image/png;
    try_files $uri =404;
  }

  # A plain check for Coolify.
  location = /healthz {
    access_log off;
    default_type text/plain;
    return 200 "ok\n";
  }

  error_page 404 /404.html;
}
