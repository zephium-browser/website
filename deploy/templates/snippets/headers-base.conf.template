# Sent with every response, whichever location serves it. nginx drops inherited
# add_header lines inside a location that adds its own, so each location
# includes this file again. headers.conf adds the site's CSP and referrer policy
# on top; the billing return page sets its own.
add_header X-Content-Type-Options "nosniff" always;
add_header X-Frame-Options "DENY" always;
add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()" always;
