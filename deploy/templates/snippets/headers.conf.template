# Sent with every page and file of the site: the shared headers, the site's
# referrer policy and its CSP. Each location includes this file again, because
# nginx drops inherited add_header lines inside a location that adds its own.
include /etc/nginx/snippets/headers-base.conf;
add_header Referrer-Policy "strict-origin-when-cross-origin" always;
# External connections are limited to configured Umami and the fixed waitlist
# API; frames only to the film's youtube-nocookie.com player. Next.js inlines
# its bootstrap scripts, hence 'unsafe-inline'.
add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' ${UMAMI_ORIGIN}; connect-src 'self' ${UMAMI_ORIGIN} ${LINUX_WAITLIST_API_ORIGIN}; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; frame-src https://www.youtube-nocookie.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" always;
